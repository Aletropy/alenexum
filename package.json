{
  "name": "nexum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bench": "turbo run bench",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm build",
    "docs:check": "pnpm --filter website check",
    "docs:build": "pnpm --filter website build",
    "docs:start": "pnpm --filter website start",
    "dev:sandbox": "pnpm --filter sandbox-bot dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
