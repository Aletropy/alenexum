{
  "name": "@alenexum/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "bench": "vitest bench --run bench",
    "lint": "biome check src test bench",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@alenexum/testing": "workspace:*",
    "@alenexum/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "author": "Aletropy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aletropy/alenexum.git"
  },
  "publishConfig": {
    "access": "public"
  }
